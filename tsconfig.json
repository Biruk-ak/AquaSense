{
  "compilerOptions": {
    "module": "commonjs",
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "target": "ES2021",
    "sourceMap": true,
    "outDir": "./dist",
    "baseUrl": "./",
    "incremental": true,
    "skipLibCheck": true,
    "strictNullChecks": true,
    "noImplicitAny": true,
    "jsx": "react-jsx",
    "resolveJsonModule": true,
    "paths": {
      "@aquasense/common": [
        "libs/common/src/index.ts"
      ],
      "@aquasense/common/*": [
        "libs/common/src/*"
      ],
      "@aquasense/domain": [
        "libs/domain/src/index.ts"
      ],
      "@aquasense/domain/*": [
        "libs/domain/src/*"
      ],
      "@aquasense/database": [
        "libs/database/src/index.ts"
      ],
      "@aquasense/database/*": [
        "libs/database/src/*"
      ]
    }
  },
  "include": [
    "apps/**/*",
    "libs/**/*",
    "types/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "coverage"
  ]
}
